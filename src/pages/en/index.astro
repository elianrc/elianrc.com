---
import SiteLayout from '@/layouts/SiteLayout.astro'
import BubbleBackground from '@/components/BubbleBackground.astro'
import Nav from '@/components/Nav.astro'
import Hero from '@/components/Hero.astro'
import ValueProp from '@/components/ValueProp.astro'
import Services from '@/components/Services.astro'
import Features from '@/components/Features.astro'
import MeetingCTA from '@/components/MeetingCTA.astro'
import About from '@/components/About.astro'
import LimitedSpots from '@/components/LimitedSpots.astro'
import Footer from '@/components/Footer.astro'
---

<SiteLayout lang="en">
