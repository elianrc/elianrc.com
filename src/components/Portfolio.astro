---
import Container from '@/components/Container.astro'
import { projects } from '@/data/projects'
import { t } from '@/data/translations'
import { externalLinkIcon } from '@/components/icons'

type Props = { lang: 'es' | 'en' }
const { lang } = Astro.props as Props
const tr = t[lang].portfolio
---

<section id="portfolio" class="px-4 py-16 sm:px-6 sm:py-20 md:px-8 lg:px-12 lg:py-24 bg-zinc-950">
  <Container>
    <h2 class="mb-10 text-center text-2xl font-bold sm:text-3xl md:mb-12 md:text-4xl">{tr.headline}</h2>
    {projects.length === 0 ? (
      <p class="text-center text-zinc-500">{tr.empty}</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="group border border-zinc-800 rounded-xl overflow-hidden hover:border-brand transition-colors">
            {project.image && <img src={project.image} alt={project.title} class="w-full h-48 object-cover" />}
            <div class="p-4 space-y-2">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-semibold group-hover:text-brand transition-colors">{project.title}</h3>
                <span class="contents" set:html={externalLinkIcon('h-4 w-4 shrink-0 text-zinc-500')}></span>
              </div>
              <p class="text-zinc-400 text-sm">{project.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="text-xs bg-zinc-800 text-zinc-300 px-2 py-0.5 rounded">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </Container>
</section>
