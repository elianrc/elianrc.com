---
import Container from '@/components/Container.astro'
import { t } from '@/data/translations'

type Props = { lang: 'es' | 'en' }
const { lang } = Astro.props as Props
const tr = t[lang].nav
const switchHref = lang === 'es' ? '/en/' : '/'
---

<nav class="px-4 py-4 sm:px-6 md:px-8 lg:px-12 bg-zinc-950">
  <Container class="flex flex-col items-center justify-between gap-4 sm:flex-row">
    <a href={lang === 'es' ? '/' : '/en/'} class="shrink-0">
      <img src="/images/dark-back-logo.png" alt="Elián RC" class="h-12 w-auto sm:h-14 md:h-16" />
    </a>

    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm sm:justify-end md:gap-x-8 md:text-base">
      <a href={lang === 'es' ? '/' : '/en/'} class="text-white hover:text-brand transition-colors">Inicio</a>
      <a href="#services" class="text-white hover:text-brand transition-colors">{tr.services}</a>
      <a href="#portfolio" class="text-white hover:text-brand transition-colors">Portfolio</a>
      <a href={switchHref} class="min-h-9 rounded border border-zinc-700 px-3 py-1 text-sm font-semibold text-white transition-colors hover:border-brand hover:text-brand">
        {tr.langToggle}
      </a>
    </div>
  </Container>
</nav>
