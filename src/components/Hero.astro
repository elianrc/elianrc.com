---
import Container from '@/components/Container.astro'
import { whatsappUrl } from '@/data/constants'
import { t } from '@/data/translations'
import { whatsappIcon } from '@/components/icons'

type Props = { lang: 'es' | 'en' }
const { lang } = Astro.props as Props
const tr = t[lang].hero
---

<section class="px-4 pt-8 pb-16 sm:px-6 sm:pt-12 sm:pb-20 md:px-8 lg:px-12 lg:pb-24 bg-zinc-950">
  <Container class="grid min-w-0 grid-cols-1 items-center gap-8 md:grid-cols-2 lg:gap-12">
    <div class="min-w-0 max-w-2xl space-y-5 sm:space-y-6">
      <h1 class="break-words text-3xl font-bold leading-tight uppercase sm:text-4xl md:text-5xl lg:text-6xl">{tr.headline}</h1>
      <p class="text-base leading-relaxed text-white whitespace-pre-line sm:text-lg">{tr.subtext}</p>
      <p class="font-bold underline">{tr.help}</p>
      <a href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer" class="inline-flex w-full max-w-full items-center justify-center gap-2 rounded-lg bg-brand px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-hover sm:w-auto">
        <span class="contents" set:html={whatsappIcon('w-5 h-5')}></span>
        {tr.cta}
      </a>
    </div>
    <div class="flex min-w-0 justify-center">
      <img src="/images/project-ohd.jpg" alt="Project showcase" class="h-auto min-w-0 w-full max-w-lg rounded-lg shadow-2xl" />
    </div>
  </Container>
</section>
